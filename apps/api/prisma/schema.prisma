model StudentCertificate {
  id           String          @id @default(uuid())
  tenantId     String          @map("tenant_id")
  candidateId  String          @map("candidate_id")
  type         CertificateType
  title        String
  certificateNo String         @map("certificate_no")
  issuedAt     DateTime        @default(now()) @map("issued_at")
  validUntil   DateTime?       @map("valid_until") @db.Date
  data         Json?
  issuedById   String?         @map("issued_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate    Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  issuedBy     User?           @relation("CertificateIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, certificateNo])
  @@index([tenantId, candidateId, type])
  @@map("student_certificates")
}

model FeeScholarship {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  candidateId   String    @map("candidate_id")
  name          String
  discountType  String    @default("PERCENT") @map("discount_type")
  discountValue Decimal   @map("discount_value") @db.Decimal(10, 2)
  academicYearId String?  @map("academic_year_id")
  isActive      Boolean   @default(true) @map("is_active")
  remarks       String?
  createdAt     DateTime  @default(now()) @map("created_at")
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([tenantId, candidateId])
  @@map("fee_scholarships")
}

model StaffAttendance {
  id        String           @id @default(uuid())
  staffId   String           @map("staff_id")
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  checkIn   String?          @map("check_in")
  checkOut  String?          @map("check_out")
  remarks   String?
  createdAt DateTime         @default(now()) @map("created_at")
  staff     StaffProfile     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([staffId, date])
  @@map("staff_attendance")
}

model StudentLeaveApplication {
  id          String             @id @default(uuid())
  tenantId    String             @map("tenant_id")
  candidateId String             @map("candidate_id")
  startDate   DateTime           @map("start_date") @db.Date
  endDate     DateTime           @map("end_date") @db.Date
  reason      String?
  status      StudentLeaveStatus @default(PENDING)
  applicantId String?            @map("applicant_id")
  approvedById String?           @map("approved_by_id")
  approvedAt  DateTime?          @map("approved_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  candidate   Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicant   User?              @relation("StudentLeaveApplicant", fields: [applicantId], references: [id], onDelete: SetNull)
  approvedBy  User?              @relation("StudentLeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([tenantId, candidateId, status])
  @@map("student_leave_applications")
}

model StudentPromotion {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  candidateId    String   @map("candidate_id")
  fromBatchId    String   @map("from_batch_id")
  toBatchId      String   @map("to_batch_id")
  academicYearId String   @map("academic_year_id")
  promotedAt     DateTime @default(now()) @map("promoted_at")
  promotedById   String?  @map("promoted_by_id")
  remarks        String?
  candidate      Candidate @relation("PromotionStudent", fields: [candidateId], references: [id], onDelete: Cascade)
  fromBatch      Batch    @relation("PromotionFromBatch", fields: [fromBatchId], references: [id], onDelete: Cascade)
  toBatch        Batch    @relation("PromotionToBatch", fields: [toBatchId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  promotedBy     User?    @relation("PromotionBy", fields: [promotedById], references: [id], onDelete: SetNull)

  @@index([tenantId, academicYearId])
  @@map("student_promotions")
}

model GradingBoardConfig {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  boardType   BoardType @default(CBSE) @map("board_type")
  name        String
  gradeRules  Json      @map("grade_rules")
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("grading_board_configs")
}

model OnlinePaymentOrder {
  id              String              @id @default(uuid())
  tenantId        String              @map("tenant_id")
  invoiceId       String              @map("invoice_id")
  gateway         String              @default("RAZORPAY")
  gatewayOrderId  String?             @map("gateway_order_id")
  amount          Decimal             @db.Decimal(12, 2)
  currency        String              @default("INR")
  status          OnlinePaymentStatus @default(CREATED)
  paidAt          DateTime?           @map("paid_at")
  metadata        Json?
  createdAt       DateTime            @default(now()) @map("created_at")
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice         FeeInvoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([gatewayOrderId])
  @@map("online_payment_orders")
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([tenantId, name])
  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  tenantId    String              @map("tenant_id")
  supplierId  String              @map("supplier_id")
  orderNo     String              @map("order_no")
  items       Json
  totalAmount Decimal             @map("total_amount") @db.Decimal(12, 2)
  status      PurchaseOrderStatus @default(DRAFT)
  orderedAt   DateTime?           @map("ordered_at")
  receivedAt  DateTime?           @map("received_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([tenantId, orderNo])
  @@map("purchase_orders")
}

model VehicleMaintenance {
  id          String           @id @default(uuid())
  vehicleId   String           @map("vehicle_id")
  date        DateTime         @db.Date
  description String
  cost        Decimal          @default(0) @db.Decimal(10, 2)
  nextDueDate DateTime?        @map("next_due_date") @db.Date
  createdAt   DateTime         @default(now()) @map("created_at")
  vehicle     TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, date])
  @@map("vehicle_maintenance")
}

model HostelVisitorPass {
  id           String    @id @default(uuid())
  candidateId  String    @map("candidate_id")
  visitorName  String    @map("visitor_name")
  visitorPhone String?   @map("visitor_phone")
  relation     String?
  visitDate    DateTime  @map("visit_date") @db.Date
  visitTime    String?   @map("visit_time")
  purpose      String?
  approved     Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at")
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, visitDate])
  @@map("hostel_visitor_passes")
}

model SubstituteAssignment {
  id                  String        @id @default(uuid())
  tenantId            String        @map("tenant_id")
  timetableSlotId     String        @map("timetable_slot_id")
  originalTeacherId   String        @map("original_teacher_id")
  substituteTeacherId String        @map("substitute_teacher_id")
  date                DateTime      @db.Date
  remarks             String?
  createdAt           DateTime      @default(now()) @map("created_at")
  timetableSlot       TimetableSlot @relation(fields: [timetableSlotId], references: [id], onDelete: Cascade)
  originalTeacher     User          @relation("OriginalTeacher", fields: [originalTeacherId], references: [id], onDelete: Cascade)
  substituteTeacher   User          @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@map("substitute_assignments")
}
