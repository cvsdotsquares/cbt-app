generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Multi-Tenant ───────────────────────────────────────────────

model Tenant {
  id              String              @id @default(uuid())
  name            String
  slug            String              @unique
  domain          String?             @unique
  logoUrl         String?             @map("logo_url")
  branding        Json?
  isolationMode   TenantIsolationMode @default(SCHEMA) @map("isolation_mode")
  securityConfig  Json?               @map("security_config")
  settings        Json?
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  users           User[]
  candidates      Candidate[]
  questions       Question[]
  topics          Topic[]
  exams           Exam[]
  auditLogs       AuditLog[]
  batches         Batch[]
  studyMaterials  StudyMaterial[]
  academicClasses AcademicClass[]
  periodConfigs   PeriodConfig[]
  timetableSlots  TimetableSlot[]
  attendanceRecords AttendanceRecord[]
  homeworks       Homework[]
  notices         Notice[]
  liveClasses     LiveClass[]
  academicYears   AcademicYear[]
  calendarEvents  CalendarEvent[]
  admissionEnquiries AdmissionEnquiry[]
  admissionApplications AdmissionApplication[]
  feeHeads        FeeHead[]
  feeStructures   FeeStructure[]
  feeInvoices     FeeInvoice[]
  transportRoutes TransportRoute[]
  transportVehicles TransportVehicle[]
  libraryBooks    LibraryBook[]
  staffProfiles   StaffProfile[]
  hostels         Hostel[]
  inventoryItems  InventoryItem[]
  notificationLogs NotificationLog[]
  academicTerms   AcademicTerm[]
  departments     Department[]
  branches        Branch[]
  alumniRecords   AlumniRecord[]
  studentCertificates StudentCertificate[]
  feeScholarships FeeScholarship[]
  gradingBoardConfigs GradingBoardConfig[]
  onlinePaymentOrders OnlinePaymentOrder[]
  suppliers       Supplier[]
  purchaseOrders  PurchaseOrder[]

  @@map("tenants")
}

enum TenantIsolationMode {
  SCHEMA
  DATABASE
  ROW_LEVEL
}

// ─── Authentication & Users ─────────────────────────────────────

model User {
  id              String      @id @default(uuid())
  tenantId        String      @map("tenant_id")
  email           String
  passwordHash    String      @map("password_hash")
  firstName       String      @map("first_name")
  lastName        String      @map("last_name")
  phone           String?
  avatarUrl       String?     @map("avatar_url")
  status          UserStatus  @default(PENDING_VERIFICATION)
  mfaEnabled      Boolean     @default(false) @map("mfa_enabled")
  mfaSecret       String?     @map("mfa_secret")
  emailVerified   Boolean     @default(false) @map("email_verified")
  phoneVerified   Boolean     @default(false) @map("phone_verified")
  lastLoginAt     DateTime?   @map("last_login_at")
  failedAttempts  Int         @default(0) @map("failed_attempts")
  lockedUntil     DateTime?   @map("locked_until")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  sessions        Session[]
  loginHistory    LoginHistory[]
  candidate       Candidate?
  createdQuestions Question[] @relation("QuestionCreator")
  approvedVersions QuestionVersion[] @relation("QuestionApprover")
  createdExams    Exam[]      @relation("ExamCreator")
  auditLogs       AuditLog[]
  passwordResetTokens PasswordResetToken[]
  parentLinks     ParentStudentLink[] @relation("ParentUser")
  timetableSlots  TimetableSlot[]     @relation("TimetableTeacher")
  homeworkCreated Homework[]          @relation("HomeworkCreator")
  noticesCreated  Notice[]            @relation("NoticeCreator")
  attendanceMarked AttendanceRecord[] @relation("AttendanceMarker")
  liveClassesTaught LiveClass[]       @relation("LiveClassTeacher")
  liveClassesCreated LiveClass[]      @relation("LiveClassCreator")
  liveClassJoins  LiveClassJoin[]
  admissionEnquiries AdmissionEnquiry[] @relation("EnquiryHandler")
  feePaymentsRecorded FeePayment[]    @relation("FeePaymentRecorder")
  gradeEntries    GradeEntry[]         @relation("GradeEntryTeacher")
  reportCardsIssued ReportCard[]       @relation("ReportCardIssuer")
  leaveApplications LeaveApplication[] @relation("LeaveApplicant")
  leaveApprovals  LeaveApplication[]   @relation("LeaveApprover")
  salarySlips     SalarySlip[]
  libraryIssues   LibraryIssue[]       @relation("LibraryIssuer")
  libraryReturns  LibraryIssue[]       @relation("LibraryReturner")
  disciplineRecords DisciplineRecord[] @relation("DisciplineRecorder")
  staffProfile    StaffProfile?
  departmentsHeaded Department[]       @relation("DepartmentHead")
  certificatesIssued StudentCertificate[] @relation("CertificateIssuer")
  studentLeaveApplications StudentLeaveApplication[] @relation("StudentLeaveApplicant")
  studentLeaveApprovals StudentLeaveApplication[] @relation("StudentLeaveApprover")
  promotionsDone  StudentPromotion[]   @relation("PromotionBy")
  originalSubstitutes SubstituteAssignment[] @relation("OriginalTeacher")
  substituteAssignments SubstituteAssignment[] @relation("SubstituteTeacher")

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model Role {
  id              String          @id @default(uuid())
  name            String          @unique
  description     String?
  isSystem        Boolean         @default(false) @map("is_system")
  createdAt       DateTime        @default(now()) @map("created_at")
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String          @id @default(uuid())
  code            String          @unique
  module          String
  action          String
  description     String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  roleId          String    @map("role_id")
  assignedAt      DateTime  @default(now()) @map("assigned_at")
  assignedBy      String?   @map("assigned_by")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role      @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id              String      @id @default(uuid())
  roleId          String      @map("role_id")
  permissionId    String      @map("permission_id")
  role            Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission      Permission  @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  refreshTokenHash    String    @map("refresh_token_hash")
  deviceFingerprint   String    @map("device_fingerprint")
  userAgent           String    @map("user_agent")
  ipAddress           String    @map("ip_address")
  isTrustedDevice     Boolean   @default(false) @map("is_trusted_device")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model LoginHistory {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  ipAddress           String    @map("ip_address")
  userAgent           String    @map("user_agent")
  deviceFingerprint   String    @map("device_fingerprint")
  success             Boolean
  failureReason       String?   @map("failure_reason")
  geoCountry          String?   @map("geo_country")
  geoCity             String?   @map("geo_city")
  createdAt           DateTime  @default(now()) @map("created_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("login_history")
}

// ─── Candidates ─────────────────────────────────────────────────

enum StudentStatus {
  ACTIVE
  TRANSFERRED
  ALUMNI
  WITHDRAWN
}

model Candidate {
  id                  String      @id @default(uuid())
  tenantId            String      @map("tenant_id")
  userId              String      @unique @map("user_id")
  registrationNumber  String      @map("registration_number")
  admissionNumber     String?     @map("admission_number")
  branchId            String?     @map("branch_id")
  dateOfBirth         DateTime?   @map("date_of_birth")
  gender              String?
  aadhaarHash         String?     @map("aadhaar_hash")
  kycStatus           KycStatus   @default(NOT_SUBMITTED) @map("kyc_status")
  kycVerifiedAt       DateTime?   @map("kyc_verified_at")
  studentStatus       StudentStatus @default(ACTIVE) @map("student_status")
  previousSchool      String?     @map("previous_school")
  medicalInfo         Json?       @map("medical_info")
  emergencyContact    Json?       @map("emergency_contact")
  profileData         Json?       @map("profile_data")
  photoUrl            String?     @map("photo_url")
  faceEmbedding       String?     @map("face_embedding")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  tenant              Tenant      @relation(fields: [tenantId], references: [id])
  user                User        @relation(fields: [userId], references: [id])
  branch              Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  documents           CandidateDocument[]
  registrations       ExamRegistration[]
  examSessions        ExamSession[]
  results             ExamResult[]
  batchEnrollments    BatchEnrollment[]
  topicMasteries      TopicMastery[]
  weakAreaRecommendations WeakAreaRecommendation[]
  attendanceRecords   AttendanceRecord[]
  homeworkSubmissions HomeworkSubmission[]
  parentLinks         ParentStudentLink[]
  liveClassJoins      LiveClassJoin[]
  admissionApplication AdmissionApplication?
  feeInvoices         FeeInvoice[]
  feeScholarships     FeeScholarship[]
  gradeEntries        GradeEntry[]
  reportCards         ReportCard[]
  transportAssignment TransportAssignment?
  libraryIssues       LibraryIssue[]
  hostelAllocation    HostelAllocation?
  disciplineRecords   DisciplineRecord[]
  studentCertificates StudentCertificate[]
  studentLeaveApplications StudentLeaveApplication[]
  promotionRecords    StudentPromotion[] @relation("PromotionStudent")
  alumniRecord        AlumniRecord?
  hostelVisitorPasses HostelVisitorPass[]

  @@unique([tenantId, registrationNumber])
  @@unique([tenantId, admissionNumber])
  @@index([tenantId, kycStatus])
  @@index([tenantId, studentStatus])
  @@map("candidates")
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

model CandidateDocument {
  id              String    @id @default(uuid())
  candidateId     String    @map("candidate_id")
  type            String
  fileName        String    @map("file_name")
  fileUrl         String    @map("file_url")
  fileSize        Int       @map("file_size")
  mimeType        String    @map("mime_type")
  verified        Boolean   @default(false)
  uploadedAt      DateTime  @default(now()) @map("uploaded_at")
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, type])
  @@map("candidate_documents")
}

// ─── Question Bank ──────────────────────────────────────────────

model Topic {
  id              String      @id @default(uuid())
  tenantId        String      @map("tenant_id")
  name            String
  parentId        String?     @map("parent_id")
  description     String?
  createdAt       DateTime    @default(now()) @map("created_at")
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  parent          Topic?      @relation("TopicHierarchy", fields: [parentId], references: [id])
  children        Topic[]     @relation("TopicHierarchy")
  questions       Question[]

  @@unique([tenantId, name, parentId])
  @@map("topics")
}

model Question {
  id                  String            @id @default(uuid())
  tenantId            String            @map("tenant_id")
  type                QuestionType
  difficulty          QuestionDifficulty @default(MEDIUM)
  topicId             String?           @map("topic_id")
  syllabusTopicId     String?           @map("syllabus_topic_id")
  title               String?
  description         String?
  currentVersionId    String?           @map("current_version_id")
  status              QuestionStatus    @default(DRAFT)
  createdById         String            @map("created_by_id")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  tenant              Tenant            @relation(fields: [tenantId], references: [id])
  topic               Topic?            @relation(fields: [topicId], references: [id])
  syllabusTopic       SyllabusTopic?    @relation("SyllabusTopicQuestions", fields: [syllabusTopicId], references: [id])
  createdBy           User              @relation("QuestionCreator", fields: [createdById], references: [id])
  versions            QuestionVersion[]
  tags                QuestionTag[]
  examQuestions       ExamQuestion[]
  responses           SessionResponse[]

  @@index([tenantId, type, status])
  @@index([tenantId, difficulty])
  @@index([syllabusTopicId])
  @@map("questions")
}

enum QuestionType {
  MCQ
  MSQ
  NUMERICAL
  SUBJECTIVE
  CODING
  CASE_STUDY
  ASSERTION_REASON
  FILL_BLANK
  AUDIO
  VIDEO
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum QuestionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

model QuestionVersion {
  id              String    @id @default(uuid())
  questionId      String    @map("question_id")
  versionNumber   Int       @map("version_number")
  content         Json
  options         Json?
  correctAnswer   Json?     @map("correct_answer")
  mediaRefs       Json?     @map("media_refs")
  marks           Float     @default(1)
  negativeMarks   Float     @default(0) @map("negative_marks")
  explanation     String?
  testCases       Json?     @map("test_cases")
  approvedById    String?   @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  question        Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  approvedBy      User?     @relation("QuestionApprover", fields: [approvedById], references: [id])

  @@unique([questionId, versionNumber])
  @@map("question_versions")
}

model QuestionTag {
  id              String    @id @default(uuid())
  questionId      String    @map("question_id")
  tag             String

  question        Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, tag])
  @@index([tag])
  @@map("question_tags")
}

// ─── Exams ──────────────────────────────────────────────────────

model Exam {
  id              String      @id @default(uuid())
  tenantId        String      @map("tenant_id")
  title           String
  code            String
  type            ExamType
  status          ExamStatus  @default(DRAFT)
  description     String?
  startTime       DateTime    @map("start_time")
  endTime         DateTime    @map("end_time")
  timezone        String      @default("UTC")
  settings        Json?
  securityPolicy  Json?               @map("security_policy")
  createdById     String      @map("created_by_id")
  publishedAt     DateTime?   @map("published_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  createdBy       User        @relation("ExamCreator", fields: [createdById], references: [id])
  sections        ExamSection[]
  registrations   ExamRegistration[]
  sessions        ExamSession[]
  results         ExamResult[]
  aiTestConfig    AiTestConfig?

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([startTime, endTime])
  @@map("exams")
}

enum ExamType {
  GOVERNMENT
  UNIVERSITY
  RECRUITMENT
  CERTIFICATION
  ONLINE_ASSESSMENT
  CODING
  PRACTICE
  AI_ASSESSMENT
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ExamSection {
  id              String    @id @default(uuid())
  examId          String    @map("exam_id")
  name            String
  description     String?
  orderIndex      Int       @map("order_index")
  durationMinutes Int?      @map("duration_minutes")
  instructions    String?
  negativeMarking Boolean   @default(false) @map("negative_marking")
  createdAt       DateTime  @default(now()) @map("created_at")
  exam            Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions       ExamQuestion[]

  @@unique([examId, orderIndex])
  @@map("exam_sections")
}

model ExamQuestion {
  id              String    @id @default(uuid())
  examId          String    @map("exam_id")
  sectionId       String    @map("section_id")
  questionId      String    @map("question_id")
  orderIndex      Int       @map("order_index")
  marks           Float?
  negativeMarks   Float?    @map("negative_marks")
  section         ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question        Question  @relation(fields: [questionId], references: [id])

  @@unique([sectionId, questionId])
  @@index([examId])
  @@map("exam_questions")
}

model ExamRegistration {
  id              String              @id @default(uuid())
  examId          String              @map("exam_id")
  candidateId     String              @map("candidate_id")
  status          RegistrationStatus  @default(REGISTERED)
  admitCardUrl    String?             @map("admit_card_url")
  registeredAt    DateTime            @default(now()) @map("registered_at")
  exam            Exam                @relation(fields: [examId], references: [id])
  candidate       Candidate           @relation(fields: [candidateId], references: [id])
  sessions        ExamSession[]

  @@unique([examId, candidateId])
  @@index([examId, status])
  @@map("exam_registrations")
}

enum RegistrationStatus {
  REGISTERED
  ADMIT_CARD_ISSUED
  CHECKED_IN
  APPEARED
  ABSENT
}

// ─── Exam Engine ────────────────────────────────────────────────

model ExamSession {
  id                  String          @id @default(uuid())
  examId              String          @map("exam_id")
  candidateId         String          @map("candidate_id")
  registrationId      String          @map("registration_id")
  status              SessionStatus   @default(WAITING)
  startedAt           DateTime?       @map("started_at")
  submittedAt         DateTime?       @map("submitted_at")
  timeRemainingSeconds Int?           @map("time_remaining_seconds")
  currentSectionId    String?         @map("current_section_id")
  questionOrder       Json?           @map("question_order")
  riskScore           Float           @default(0) @map("risk_score")
  ipAddress           String?         @map("ip_address")
  deviceFingerprint   String?         @map("device_fingerprint")
  userAgent           String?         @map("user_agent")
  attemptNumber       Int             @default(1) @map("attempt_number")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  exam                Exam            @relation(fields: [examId], references: [id])
  candidate           Candidate       @relation(fields: [candidateId], references: [id])
  registration        ExamRegistration @relation(fields: [registrationId], references: [id])
  responses           SessionResponse[]
  proctoringEvents    ProctoringEvent[]
  securityViolations  SecurityViolation[]
  result              ExamResult?

  @@index([examId, status])
  @@index([candidateId, examId])
  @@index([examId, status, candidateId])
  @@map("exam_sessions")
}

enum SessionStatus {
  WAITING
  IDENTITY_VERIFICATION
  IN_PROGRESS
  PAUSED
  SUBMITTED
  AUTO_SUBMITTED
  TERMINATED
  EXPIRED
}

model SessionResponse {
  id                  String    @id @default(uuid())
  sessionId           String    @map("session_id")
  questionId          String    @map("question_id")
  answer              Json?
  isCorrect           Boolean?  @map("is_correct")
  marksAwarded        Float?    @map("marks_awarded")
  markedForReview     Boolean   @default(false) @map("marked_for_review")
  timeSpentSeconds    Int       @default(0) @map("time_spent_seconds")
  answeredAt          DateTime? @map("answered_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  session             ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question            Question  @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@map("session_responses")
}

// ─── Proctoring & Security ──────────────────────────────────────

model ProctoringEvent {
  id              String              @id @default(uuid())
  sessionId       String              @map("session_id")
  eventType       ProctoringEventType @map("event_type")
  confidence      Float?
  severity        ViolationSeverity   @default(LOW)
  metadata        Json?
  snapshotUrl     String?             @map("snapshot_url")
  occurredAt      DateTime            @default(now()) @map("occurred_at")
  session         ExamSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, occurredAt(sort: Desc)])
  @@index([sessionId, severity])
  @@map("proctoring_events")
}

enum ProctoringEventType {
  NO_FACE
  MULTIPLE_FACES
  FACE_MISMATCH
  LOOKING_AWAY
  HEAD_TURNED
  PHONE_DETECTED
  AUDIO_ANOMALY
  TAB_SWITCH
  WINDOW_BLUR
  COPY_ATTEMPT
  PASTE_ATTEMPT
  RIGHT_CLICK
  DEVTOOLS
  PRINT_ATTEMPT
  SCREEN_CAPTURE
  FULLSCREEN_EXIT
  VPN_DETECTED
  VM_DETECTED
}

enum ViolationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SecurityViolation {
  id              String              @id @default(uuid())
  sessionId       String              @map("session_id")
  type            String
  severity        ViolationSeverity   @default(MEDIUM)
  details         Json?
  actionTaken     String?             @map("action_taken")
  occurredAt      DateTime            @default(now()) @map("occurred_at")
  session         ExamSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, occurredAt(sort: Desc)])
  @@map("security_violations")
}

// ─── Results ────────────────────────────────────────────────────

model ExamResult {
  id                  String            @id @default(uuid())
  sessionId           String            @unique @map("session_id")
  examId              String            @map("exam_id")
  candidateId         String            @map("candidate_id")
  totalScore          Float             @map("total_score")
  maxScore            Float             @map("max_score")
  percentage          Float
  rank                Int?
  percentile          Float?
  evaluationStatus    EvaluationStatus  @default(PENDING) @map("evaluation_status")
  published           Boolean           @default(false)
  publishedAt         DateTime?         @map("published_at")
  cutoffMet           Boolean?          @map("cutoff_met")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  session             ExamSession       @relation(fields: [sessionId], references: [id])
  exam                Exam              @relation(fields: [examId], references: [id])
  candidate           Candidate         @relation(fields: [candidateId], references: [id])
  sectionResults      SectionResult[]

  @@index([examId, rank])
  @@index([examId, published])
  @@index([candidateId])
  @@map("exam_results")
}

enum EvaluationStatus {
  PENDING
  AUTO_EVALUATED
  MANUAL_REVIEW
  EVALUATED
  PUBLISHED
}

model SectionResult {
  id              String      @id @default(uuid())
  resultId        String      @map("result_id")
  sectionId       String      @map("section_id")
  sectionName     String      @map("section_name")
  score           Float
  maxScore        Float       @map("max_score")
  percentage      Float

  result          ExamResult  @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@map("section_results")
}

// ─── Coding Submissions ─────────────────────────────────────────

model CodingSubmission {
  id              String    @id @default(uuid())
  sessionId       String    @map("session_id")
  questionId      String    @map("question_id")
  language        String
  sourceCode      String    @map("source_code")
  testResults     Json?     @map("test_results")
  passedTests     Int       @default(0) @map("passed_tests")
  totalTests      Int       @default(0) @map("total_tests")
  executionTimeMs Int?      @map("execution_time_ms")
  memoryUsedKb    Int?      @map("memory_used_kb")
  plagiarismScore Float?    @map("plagiarism_score")
  submittedAt     DateTime  @default(now()) @map("submitted_at")

  @@index([sessionId, questionId])
  @@map("coding_submissions")
}

// ─── Audit ──────────────────────────────────────────────────────

model AuditLog {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  userId          String?   @map("user_id")
  action          String
  resourceType    String    @map("resource_type")
  resourceId      String?   @map("resource_id")
  oldValue        Json?     @map("old_value")
  newValue        Json?     @map("new_value")
  ipAddress       String?   @map("ip_address")
  userAgent       String?   @map("user_agent")
  severity        String    @default("INFO")
  createdAt       DateTime  @default(now()) @map("created_at")
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  user            User?     @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── Curriculum (NCERT Syllabus) ────────────────────────────────

model AcademicClass {
  id          String    @id @default(uuid())
  tenantId    String?   @map("tenant_id")
  level       Int
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  subjects    Subject[]
  batches     Batch[]
  studyMaterials StudyMaterial[]

  @@unique([tenantId, level])
  @@map("academic_classes")
}

model Subject {
  id              String        @id @default(uuid())
  academicClassId String        @map("academic_class_id")
  name            String
  code            String
  description     String?
  orderIndex      Int           @default(0) @map("order_index")
  createdAt       DateTime      @default(now()) @map("created_at")
  academicClass   AcademicClass @relation(fields: [academicClassId], references: [id], onDelete: Cascade)
  books           Book[]
  teacherAssignments TeacherAssignment[]
  topicMasteries  TopicMastery[]
  studyMaterials  StudyMaterial[]
  timetableSlots  TimetableSlot[]
  homeworks       Homework[]
  liveClasses     LiveClass[]
  gradeEntries    GradeEntry[]

  @@unique([academicClassId, code])
  @@map("subjects")
}

model Book {
  id          String    @id @default(uuid())
  subjectId   String    @map("subject_id")
  title       String
  publisher   String    @default("NCERT")
  isNcert     Boolean   @default(true) @map("is_ncert")
  edition     String?
  orderIndex  Int       @default(0) @map("order_index")
  createdAt   DateTime  @default(now()) @map("created_at")
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapters    Chapter[]
  materials   StudyMaterial[]

  @@map("books")
}

model Chapter {
  id          String    @id @default(uuid())
  bookId      String    @map("book_id")
  number      Int
  title       String
  description String?
  orderIndex  Int       @default(0) @map("order_index")
  createdAt   DateTime  @default(now()) @map("created_at")
  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  topics      SyllabusTopic[]
  syllabusProgress SyllabusProgress[]
  materials   StudyMaterial[]
  documentChunks DocumentChunk[]

  @@unique([bookId, number])
  @@map("chapters")
}

model SyllabusTopic {
  id          String    @id @default(uuid())
  chapterId   String    @map("chapter_id")
  title       String
  description String?
  orderIndex  Int       @default(0) @map("order_index")
  createdAt   DateTime  @default(now()) @map("created_at")
  chapter     Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  subTopics   SubTopic[]
  syllabusProgress SyllabusProgress[]
  materials   StudyMaterial[]
  documentChunks DocumentChunk[]
  topicMasteries TopicMastery[]
  weakAreaRecommendations WeakAreaRecommendation[]
  questions   Question[] @relation("SyllabusTopicQuestions")

  @@map("syllabus_topics")
}

model SubTopic {
  id          String        @id @default(uuid())
  topicId     String        @map("topic_id")
  title       String
  description String?
  orderIndex  Int           @default(0) @map("order_index")
  createdAt   DateTime      @default(now()) @map("created_at")
  topic       SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  documentChunks DocumentChunk[]

  @@map("sub_topics")
}

// ─── Batches & Enrollment ───────────────────────────────────────

model Batch {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  academicClassId String        @map("academic_class_id")
  name            String
  academicYear    String        @map("academic_year")
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  academicClass   AcademicClass @relation(fields: [academicClassId], references: [id])
  enrollments     BatchEnrollment[]
  syllabusProgress SyllabusProgress[]
  teacherAssignments TeacherAssignment[]
  aiTestConfigs   AiTestConfig[]
  timetableSlots  TimetableSlot[]
  attendanceRecords AttendanceRecord[]
  homeworks       Homework[]
  liveClasses     LiveClass[]
  feeStructures   FeeStructure[]
  promotionsFrom  StudentPromotion[] @relation("PromotionFromBatch")
  promotionsTo    StudentPromotion[] @relation("PromotionToBatch")

  @@unique([tenantId, name, academicYear, academicClassId])
  @@index([tenantId, isActive])
  @@map("batches")
}

model BatchEnrollment {
  id          String    @id @default(uuid())
  batchId     String    @map("batch_id")
  candidateId String    @map("candidate_id")
  rollNumber  String?   @map("roll_number")
  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  batch       Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([batchId, candidateId])
  @@map("batch_enrollments")
}

model TeacherAssignment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  batchId   String   @map("batch_id")
  subjectId String   @map("subject_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, batchId, subjectId])
  @@map("teacher_assignments")
}

model SyllabusProgress {
  id          String                @id @default(uuid())
  batchId     String                @map("batch_id")
  chapterId   String?               @map("chapter_id")
  topicId     String?               @map("topic_id")
  status      SyllabusProgressStatus @default(NOT_STARTED)
  completedAt DateTime?             @map("completed_at")
  updatedById String?               @map("updated_by_id")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  batch       Batch                 @relation(fields: [batchId], references: [id], onDelete: Cascade)
  chapter     Chapter?              @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  topic       SyllabusTopic?        @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([batchId, chapterId, topicId])
  @@index([batchId, status])
  @@map("syllabus_progress")
}

enum SyllabusProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ─── Study Materials & RAG ──────────────────────────────────────

model StudyMaterial {
  id               String         @id @default(uuid())
  tenantId         String         @map("tenant_id")
  academicClassId  String?        @map("academic_class_id")
  subjectId        String?        @map("subject_id")
  bookId           String?        @map("book_id")
  chapterId        String?        @map("chapter_id")
  topicId          String?        @map("topic_id")
  isFullBook       Boolean        @default(true) @map("is_full_book")
  type             MaterialType
  title            String
  fileName         String         @map("file_name")
  fileUrl          String         @map("file_url")
  fileSize         Int            @map("file_size")
  mimeType         String         @map("mime_type")
  academicSession  String         @default("2025-26") @map("academic_session")
  version          Int            @default(1)
  uploadedById     String?        @map("uploaded_by_id")
  status           MaterialStatus @default(PENDING)
  errorMessage     String?        @map("error_message")
  chunkCount       Int            @default(0) @map("chunk_count")
  indexedAt        DateTime?      @map("indexed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  academicClass    AcademicClass? @relation(fields: [academicClassId], references: [id])
  subject          Subject?       @relation(fields: [subjectId], references: [id])
  book             Book?          @relation(fields: [bookId], references: [id])
  chapter          Chapter?       @relation(fields: [chapterId], references: [id])
  topic            SyllabusTopic? @relation(fields: [topicId], references: [id])
  chunks           DocumentChunk[]

  @@index([tenantId, status])
  @@index([tenantId, academicClassId, subjectId])
  @@index([chapterId])
  @@map("study_materials")
}

enum MaterialType {
  NCERT
  INSTITUTE_NOTES
  QUESTION_BANK
  WORKSHEET
  TEACHER_NOTES
}

enum MaterialStatus {
  PENDING
  INDEXING
  READY
  FAILED
}

model DocumentChunk {
  id              String         @id @default(uuid())
  materialId      String         @map("material_id")
  content         String
  chunkIndex      Int            @map("chunk_index")
  pageNumber      Int?           @map("page_number")
  tokenCount      Int            @default(0) @map("token_count")
  embedding       Json?
  academicClassId String?        @map("academic_class_id")
  subjectId       String?        @map("subject_id")
  chapterId       String?        @map("chapter_id")
  topicId         String?        @map("topic_id")
  subTopicId      String?        @map("sub_topic_id")
  metadata        Json?
  createdAt       DateTime       @default(now()) @map("created_at")
  material        StudyMaterial  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  chapter         Chapter?       @relation(fields: [chapterId], references: [id])
  topic           SyllabusTopic? @relation(fields: [topicId], references: [id])
  subTopic        SubTopic?      @relation(fields: [subTopicId], references: [id])

  @@index([materialId, chunkIndex])
  @@index([chapterId])
  @@index([topicId])
  @@map("document_chunks")
}

// ─── AI Test Configuration ──────────────────────────────────────

model AiTestConfig {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  batchId         String?  @map("batch_id")
  subjectId       String?  @map("subject_id")
  title           String
  chapterIds      Json     @map("chapter_ids")
  topicIds        Json?    @map("topic_ids")
  questionCount   Int      @default(10) @map("question_count")
  difficultyMix   Json?    @map("difficulty_mix")
  questionTypes   Json     @map("question_types")
  syllabusScope   String   @default("COMPLETED_ONLY") @map("syllabus_scope")
  examId          String?  @unique @map("exam_id")
  createdById     String   @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  batch           Batch?   @relation(fields: [batchId], references: [id])
  exam            Exam?    @relation(fields: [examId], references: [id])

  @@index([tenantId])
  @@map("ai_test_configs")
}

model GeneratedQuestionRecord {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  questionHash      String   @map("question_hash")
  questionId        String?  @map("question_id")
  sourceChunkIds    Json     @map("source_chunk_ids")
  sourceMaterialIds Json?    @map("source_material_ids")
  sourceChapterId   String?  @map("source_chapter_id")
  sourceTopicId     String?  @map("source_topic_id")
  confidenceScore   Float?   @map("confidence_score")
  batchId           String?  @map("batch_id")
  candidateId       String?  @map("candidate_id")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([tenantId, questionHash])
  @@index([batchId, candidateId])
  @@map("generated_question_records")
}

// ─── Learning Analytics ───────────────────────────────────────────

model TopicMastery {
  id            String        @id @default(uuid())
  candidateId   String        @map("candidate_id")
  topicId       String        @map("topic_id")
  subjectId     String        @map("subject_id")
  accuracy      Float         @default(0)
  attempts      Int           @default(0)
  correctCount  Int           @default(0) @map("correct_count")
  lastAttemptAt DateTime?     @map("last_attempt_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  candidate     Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  topic         SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subject       Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([candidateId, topicId])
  @@index([candidateId, subjectId])
  @@map("topic_masteries")
}

model WeakAreaRecommendation {
  id          String        @id @default(uuid())
  candidateId String        @map("candidate_id")
  topicId     String        @map("topic_id")
  reason      String
  priority    Int           @default(1)
  isResolved  Boolean       @default(false) @map("is_resolved")
  createdAt   DateTime      @default(now()) @map("created_at")
  candidate   Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  topic       SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([candidateId, isResolved])
  @@map("weak_area_recommendations")
}

// ─── School Operations ──────────────────────────────────────────

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HALF_DAY
}

enum HomeworkSubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
}

enum NoticeTarget {
  ALL
  BATCH
  ACADEMIC_CLASS
}

model PeriodConfig {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  periodNumber Int      @map("period_number")
  label        String
  startTime    String   @map("start_time")
  endTime      String   @map("end_time")
  createdAt    DateTime @default(now()) @map("created_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodNumber])
  @@map("period_configs")
}

model TimetableSlot {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  batchId      String    @map("batch_id")
  subjectId    String    @map("subject_id")
  teacherId    String?   @map("teacher_id")
  dayOfWeek    DayOfWeek @map("day_of_week")
  periodNumber Int       @map("period_number")
  room         String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch        Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject      Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      User?     @relation("TimetableTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  substituteAssignments SubstituteAssignment[]

  @@unique([batchId, dayOfWeek, periodNumber])
  @@index([tenantId, batchId])
  @@map("timetable_slots")
}

model AttendanceRecord {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  batchId     String           @map("batch_id")
  candidateId String           @map("candidate_id")
  date        DateTime         @db.Date
  status      AttendanceStatus @default(ABSENT)
  markedById  String?          @map("marked_by_id")
  remarks     String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch       Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  markedBy    User?            @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([batchId, candidateId, date])
  @@index([tenantId, batchId, date])
  @@index([candidateId, date])
  @@map("attendance_records")
}

model Homework {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  batchId     String   @map("batch_id")
  subjectId   String   @map("subject_id")
  title       String
  description String?
  dueDate     DateTime @map("due_date")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("HomeworkCreator", fields: [createdById], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[]

  @@index([tenantId, batchId])
  @@index([dueDate])
  @@map("homeworks")
}

model HomeworkSubmission {
  id          String                   @id @default(uuid())
  homeworkId  String                   @map("homework_id")
  candidateId String                   @map("candidate_id")
  content     String?
  status      HomeworkSubmissionStatus @default(PENDING)
  submittedAt DateTime?                @map("submitted_at")
  grade       String?
  feedback    String?
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  homework    Homework                 @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  candidate   Candidate                @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, candidateId])
  @@map("homework_submissions")
}

model Notice {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  title       String
  body        String
  targetType  NoticeTarget @default(ALL) @map("target_type")
  targetId    String?      @map("target_id")
  isPublished Boolean      @default(true) @map("is_published")
  createdById String       @map("created_by_id")
  expiresAt   DateTime?    @map("expires_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("NoticeCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tenantId, isPublished, createdAt(sort: Desc)])
  @@map("notices")
}

model ParentStudentLink {
  id           String    @id @default(uuid())
  parentUserId String    @map("parent_user_id")
  candidateId  String    @map("candidate_id")
  relation     String    @default("Parent")
  createdAt    DateTime  @default(now()) @map("created_at")
  parent       User      @relation("ParentUser", fields: [parentUserId], references: [id], onDelete: Cascade)
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, candidateId])
  @@map("parent_student_links")
}

enum LiveClassProvider {
  JITSI
  ZOOM
  GOOGLE_MEET
  MICROSOFT_TEAMS
  CUSTOM
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

model LiveClass {
  id           String            @id @default(uuid())
  tenantId     String            @map("tenant_id")
  batchId      String            @map("batch_id")
  subjectId    String            @map("subject_id")
  teacherId    String            @map("teacher_id")
  title        String
  description  String?
  startTime    DateTime          @map("start_time")
  endTime      DateTime          @map("end_time")
  provider     LiveClassProvider @default(JITSI)
  meetingUrl   String            @map("meeting_url")
  recordingUrl String?           @map("recording_url")
  status       LiveClassStatus   @default(SCHEDULED)
  createdById  String            @map("created_by_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch        Batch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject      Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      User              @relation("LiveClassTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("LiveClassCreator", fields: [createdById], references: [id], onDelete: Cascade)
  joins        LiveClassJoin[]

  @@index([tenantId, batchId, startTime])
  @@index([tenantId, status, startTime])
  @@map("live_classes")
}

model LiveClassJoin {
  id          String     @id @default(uuid())
  liveClassId String     @map("live_class_id")
  userId      String     @map("user_id")
  candidateId String?    @map("candidate_id")
  joinedAt    DateTime   @default(now()) @map("joined_at")
  leftAt      DateTime?  @map("left_at")
  liveClass   LiveClass  @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@unique([liveClassId, userId])
  @@index([liveClassId])
  @@map("live_class_joins")
}

